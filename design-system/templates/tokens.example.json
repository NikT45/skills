{
  "$schema": "../references/token-schema.md",
  "meta": {
    "name": "Meridian",
    "tagline": "Calm, editorial finance for small teams",
    "version": "0.1.0",
    "createdAt": "2026-09-14",
    "platform": [
      "web",
      "ios"
    ],
    "vibe": [
      "editorial",
      "calm",
      "warm",
      "precise"
    ],
    "references": [
      "Linear (density)",
      "Stripe docs (type)",
      "Arc (warmth)"
    ],
    "antiReferences": [
      "Neon SaaS gradients",
      "Pure #000 dark mode"
    ]
  },
  "fonts": {
    "display": {
      "family": "Instrument Serif",
      "fallback": "Georgia, 'Times New Roman', serif",
      "google": "Instrument+Serif:ital@0;1",
      "weights": [
        400
      ],
      "role": "Headlines, display numbers, brand moments"
    },
    "body": {
      "family": "Inter",
      "fallback": "system-ui, -apple-system, 'Segoe UI', sans-serif",
      "google": "Inter:wght@400;500;600;700",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "role": "UI, body copy, labels, controls"
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace",
      "google": "JetBrains+Mono:wght@400;500",
      "weights": [
        400,
        500
      ],
      "role": "Code, tabular IDs, amounts in tables"
    }
  },
  "type": {
    "baseSize": 16,
    "scaleRatio": 1.25,
    "scale": {
      "display": {
        "font": "display",
        "size": 56,
        "lineHeight": 1.05,
        "weight": 400,
        "tracking": -0.02
      },
      "h1": {
        "font": "display",
        "size": 40,
        "lineHeight": 1.1,
        "weight": 400,
        "tracking": -0.02
      },
      "h2": {
        "font": "display",
        "size": 32,
        "lineHeight": 1.15,
        "weight": 400,
        "tracking": -0.015
      },
      "h3": {
        "font": "body",
        "size": 24,
        "lineHeight": 1.2,
        "weight": 600,
        "tracking": -0.01
      },
      "h4": {
        "font": "body",
        "size": 20,
        "lineHeight": 1.3,
        "weight": 600,
        "tracking": -0.005
      },
      "body-lg": {
        "font": "body",
        "size": 18,
        "lineHeight": 1.55,
        "weight": 400,
        "tracking": 0
      },
      "body": {
        "font": "body",
        "size": 16,
        "lineHeight": 1.5,
        "weight": 400,
        "tracking": 0
      },
      "body-sm": {
        "font": "body",
        "size": 14,
        "lineHeight": 1.45,
        "weight": 400,
        "tracking": 0
      },
      "label": {
        "font": "body",
        "size": 14,
        "lineHeight": 1.2,
        "weight": 500,
        "tracking": 0
      },
      "caption": {
        "font": "body",
        "size": 12,
        "lineHeight": 1.4,
        "weight": 400,
        "tracking": 0.01
      },
      "overline": {
        "font": "body",
        "size": 12,
        "lineHeight": 1.2,
        "weight": 600,
        "tracking": 0.08,
        "transform": "uppercase"
      },
      "code": {
        "font": "mono",
        "size": 14,
        "lineHeight": 1.5,
        "weight": 400,
        "tracking": 0
      }
    }
  },
  "color": {
    "primitives": {
      "neutral": {
        "0": "#FFFFFF",
        "50": "#FAFAF8",
        "100": "#F4F3EF",
        "200": "#E8E6DF",
        "300": "#D5D2C8",
        "400": "#A8A498",
        "500": "#7C786C",
        "600": "#5C5950",
        "700": "#45423B",
        "800": "#2E2C27",
        "900": "#1C1B18",
        "950": "#121110"
      },
      "brand": {
        "50": "#EEF7F3",
        "100": "#D6ECE2",
        "200": "#ADD9C6",
        "300": "#7DC0A5",
        "400": "#4FA383",
        "500": "#2F8767",
        "600": "#226C52",
        "700": "#1C5643",
        "800": "#184436",
        "900": "#14382D",
        "950": "#0A1F19"
      },
      "accent": {
        "50": "#FFF7EB",
        "100": "#FEEACC",
        "200": "#FCD592",
        "300": "#F8BA57",
        "400": "#F29F2A",
        "500": "#E4830F",
        "600": "#C2640A",
        "700": "#9C4A0C",
        "800": "#7E3B10",
        "900": "#683110",
        "950": "#3D1806"
      },
      "danger": {
        "50": "#FDF2F1",
        "100": "#FBE4E2",
        "300": "#F0A39D",
        "400": "#E0675F",
        "500": "#C93A32",
        "600": "#B8342D",
        "700": "#A32F29",
        "900": "#5C1A17",
        "950": "#2E1412"
      },
      "warning": {
        "50": "#FFF8EB",
        "100": "#FDEDCB",
        "400": "#F0A52C",
        "500": "#D97706",
        "600": "#B45F05",
        "700": "#8F4B04",
        "950": "#2E1F0A"
      },
      "success": {
        "50": "#EEF9F1",
        "100": "#D5F1DD",
        "400": "#3FBF74",
        "500": "#1F9D55",
        "600": "#187E44",
        "700": "#146537",
        "950": "#0F2418"
      },
      "info": {
        "50": "#EEF4FF",
        "100": "#DBE7FE",
        "400": "#5B8DEF",
        "500": "#2563EB",
        "600": "#1D4FC4",
        "700": "#1A3FA0",
        "950": "#131B2E"
      }
    },
    "semantic": {
      "light": {
        "background": "{neutral.50}",
        "foreground": "{neutral.950}",
        "card": "{neutral.0}",
        "card-foreground": "{neutral.950}",
        "popover": "{neutral.0}",
        "popover-foreground": "{neutral.950}",
        "primary": "{brand.600}",
        "primary-foreground": "{neutral.0}",
        "primary-hover": "{brand.700}",
        "secondary": "{neutral.100}",
        "secondary-foreground": "{neutral.900}",
        "secondary-hover": "{neutral.200}",
        "muted": "{neutral.100}",
        "muted-foreground": "{neutral.600}",
        "accent": "{accent.500}",
        "accent-foreground": "{neutral.950}",
        "accent-soft": "{accent.100}",
        "destructive": "{danger.500}",
        "destructive-foreground": "{neutral.0}",
        "destructive-soft": "{danger.100}",
        "success": "{success.500}",
        "success-soft": "{success.100}",
        "warning": "{warning.500}",
        "warning-soft": "{warning.100}",
        "info": "{info.500}",
        "info-soft": "{info.100}",
        "border": "{neutral.200}",
        "border-strong": "{neutral.300}",
        "input": "{neutral.300}",
        "ring": "{brand.500}",
        "overlay": "rgba(18, 17, 16, 0.5)"
      },
      "dark": {
        "background": "{neutral.950}",
        "foreground": "{neutral.50}",
        "card": "{neutral.900}",
        "card-foreground": "{neutral.50}",
        "popover": "{neutral.900}",
        "popover-foreground": "{neutral.50}",
        "primary": "{brand.400}",
        "primary-foreground": "{neutral.950}",
        "primary-hover": "{brand.300}",
        "secondary": "{neutral.800}",
        "secondary-foreground": "{neutral.100}",
        "secondary-hover": "{neutral.700}",
        "muted": "{neutral.800}",
        "muted-foreground": "{neutral.400}",
        "accent": "{accent.400}",
        "accent-foreground": "{neutral.950}",
        "accent-soft": "{accent.950}",
        "destructive": "{danger.400}",
        "destructive-foreground": "{neutral.950}",
        "destructive-soft": "{danger.950}",
        "success": "{success.400}",
        "success-soft": "{success.950}",
        "warning": "{warning.400}",
        "warning-soft": "{warning.950}",
        "info": "{info.400}",
        "info-soft": "{info.950}",
        "border": "{neutral.800}",
        "border-strong": "{neutral.700}",
        "input": "{neutral.700}",
        "ring": "{brand.400}",
        "overlay": "rgba(0, 0, 0, 0.6)"
      }
    }
  },
  "spacing": {
    "grid": 8,
    "halfStep": 4,
    "scale": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64,
      "20": 80,
      "24": 96
    },
    "roles": {
      "inline": "1-2 (4-8px): icon-to-label, chip padding",
      "control": "3-4 (12-16px): inside inputs and buttons",
      "component": "4-6 (16-24px): between elements in a card",
      "section": "8-12 (32-48px): between blocks on a page",
      "page": "16-24 (64-96px): between page sections, hero margins"
    }
  },
  "radius": {
    "scale": {
      "none": 0,
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16,
      "xl": 24,
      "2xl": 32,
      "full": 9999
    },
    "nesting": "inner = outer - padding (min xs). A 24px card with 16px padding gets 8px children.",
    "defaults": {
      "control": "sm",
      "card": "xl",
      "sheet": "2xl",
      "chip": "full",
      "image": "md"
    }
  },
  "layout": {
    "grid": 8,
    "containerMax": 1200,
    "columns": 12,
    "gutter": 24,
    "margin": {
      "mobile": 16,
      "tablet": 24,
      "desktop": 32
    },
    "safeArea": {
      "touchTarget": 44,
      "readingMeasure": 68
    },
    "breakpoints": {
      "sm": 640,
      "md": 768,
      "lg": 1024,
      "xl": 1280
    }
  },
  "elevation": {
    "none": "none",
    "sm": "0 1px 2px rgba(18,17,16,0.06), 0 1px 1px rgba(18,17,16,0.04)",
    "md": "0 2px 6px rgba(18,17,16,0.06), 0 8px 24px -8px rgba(18,17,16,0.12)",
    "lg": "0 4px 12px rgba(18,17,16,0.08), 0 24px 48px -16px rgba(18,17,16,0.18)",
    "rule": "Prefer borders over shadows at rest. Shadows mean 'lifted': popovers, drags, dialogs."
  },
  "motion": {
    "duration": {
      "instant": 80,
      "fast": 120,
      "base": 200,
      "slow": 320,
      "slower": 480
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "rule": "Fade + 4-8px translate for enter. No bounce on UI chrome. Respect prefers-reduced-motion."
  },
  "components": {
    "control": {
      "height": {
        "sm": 32,
        "md": 40,
        "lg": 48
      },
      "paddingX": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "radius": "sm",
      "gap": 8,
      "iconSize": {
        "sm": 16,
        "md": 16,
        "lg": 20
      }
    },
    "card": {
      "padding": 16,
      "radius": "xl",
      "border": true,
      "shadow": "none"
    },
    "input": {
      "height": 40,
      "paddingX": 12,
      "radius": "sm",
      "borderWidth": 1,
      "focusRing": 2
    },
    "badge": {
      "height": 24,
      "paddingX": 8,
      "radius": "full",
      "textStyle": "caption"
    },
    "dialog": {
      "maxWidth": 480,
      "padding": 24,
      "radius": "2xl"
    },
    "avatar": {
      "size": {
        "sm": 24,
        "md": 32,
        "lg": 40
      },
      "radius": "full"
    }
  },
  "rules": [
    "8px grid for all layout spacing. 4px only inside compact controls (icon gaps, chip padding).",
    "Radius nests: inner radius = outer radius - padding, never below 4px.",
    "One display font, one UI font. Display font only at h2 and above.",
    "Text has 5 levels max on any screen: display/h1, h3, body, label, caption.",
    "Borders at rest, shadows on lift. Never both on the same element at rest.",
    "Body text 4.5:1 contrast minimum; large text and icons 3:1.",
    "Touch targets 44px minimum on mobile even when the visual is 32px.",
    "Line length 60-75 characters for reading text. Cap with max-width, not font-size.",
    "Primary action once per view. Everything else is secondary, outline or ghost.",
    "Dark mode is not inverted light mode: lift surfaces with lighter neutrals, lower saturation, keep accent legible."
  ]
}